# ===== 阿里云 ESA 访问凭证（必填，建议使用 RAM 子账号 + 最小权限）=====
# 也可使用通用名 ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET
ESA_ACCESS_KEY_ID=LTAI****************
ESA_ACCESS_KEY_SECRET=********************************

# 使用 STS 临时凭证时填写（可选）
# ESA_SECURITY_TOKEN=

# ESA API 接入点，默认 cn-hangzhou；国际站常用 https://esa.ap-southeast-1.aliyuncs.com
# ESA_API_ENDPOINT=https://esa.cn-hangzhou.aliyuncs.com
# 单个 API 请求超时（毫秒，默认 15000）
# ESA_API_TIMEOUT_MS=15000

# ===== 默认站点 ID（ESA 控制台 → 站点概览，纯数字）=====
# 请求体不带 siteId 时使用
ESA_SITE_ID=1234567890123

# ===== 安全 =====
# 调用令牌：请求体 secret 或请求头需匹配（强烈建议设置）
WEBHOOK_TOKEN=change-me-to-a-long-random-string
# 允许更新的域名白名单，逗号分隔（不设置则不限制）
# ESA_ALLOWED_DOMAINS=www.example.com,cdn.example.com
# CORS 允许的来源，默认 *
# ESA_CORS_ORIGIN=*

# ===== 行为 =====
# 允许通过 GET /update-origin?domain=..&ip=.. 触发更新（默认关闭）
# ESA_ALLOW_GET_UPDATE=true
# 允许通过 GET /update-origin?domain=.. 查询当前回源（默认关闭，建议调试时临时开启）
# ESA_ALLOW_DESCRIBE=true
# 多源站分隔符，默认英文逗号
# ESA_ORIGIN_SEPARATOR=,
# 新建源站条目的默认权重（0-100，默认 100）
# ESA_ORIGIN_WEIGHT=100
# 缺省写入的源地址池（不设置则按域名自动识别）
# ESA_ORIGIN_POOL_ID=12345
# 禁止在站点缺少回源规则时自动创建（默认允许创建）
# ESA_ALLOW_CREATE_ORIGIN_RULE=false
# 全局演练模式：只回显将发生的变更，不写 API
# ESA_DRY_RUN=true

# 本地调试服务器端口（仅 dev-server.mjs 使用）
PORT=8787
